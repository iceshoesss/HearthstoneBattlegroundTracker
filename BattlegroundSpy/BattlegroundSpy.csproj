<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>10</LangVersion>
    <RootNamespace>BattlegroundSpy</RootNamespace>
    <AssemblyName>BattlegroundSpy</AssemblyName>
    <Version>0.2.0</Version>
    <Description>BattlegroundSpy - Hearthstone Battlegrounds memory reader</Description>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
  </PropertyGroup>

  <!-- Release 不生成 .pdb -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- UnitySpy core (MIT, source included) -->
  <ItemGroup>
    <Compile Include="..\..\..\HDT_Reverse\unity-spy\UnitySpy\**\*.cs"
             Exclude="..\..\..\HDT_Reverse\unity-spy\UnitySpy\obj\**;..\..\..\HDT_Reverse\unity-spy\UnitySpy\Properties\**;..\..\..\HDT_Reverse\unity-spy\UnitySpy\Crawler\**"
             LinkBase="UnitySpy" />
  </ItemGroup>

  <!-- UnitySpy.HearthstoneLib (MIT, source included) -->
  <ItemGroup>
    <Compile Include="..\..\..\HDT_Reverse\unity-spy\UnitySpy.HearthstoneLib\**\*.cs"
             Exclude="..\..\..\HDT_Reverse\unity-spy\UnitySpy.HearthstoneLib\obj\**;..\..\..\HDT_Reverse\unity-spy\UnitySpy.HearthstoneLib\Properties\**;..\..\..\HDT_Reverse\unity-spy\UnitySpy.HearthstoneLib\Detail\Collection\CollectionBattlegroundsHeroSkinsReader.cs;..\..\..\HDT_Reverse\unity-spy\UnitySpy.HearthstoneLib\Detail\Collection\CollectionCardReader.cs;..\..\..\HDT_Reverse\unity-spy\UnitySpy.HearthstoneLib\Detail\Achievement\AchievementsInfoReader.cs;..\..\..\HDT_Reverse\unity-spy\UnitySpy.HearthstoneLib\MindVision.cs;..\..\..\HDT_Reverse\unity-spy\UnitySpy.HearthstoneLib\Detail\DungeonInfo\DungeonInfoReader.cs;..\..\..\HDT_Reverse\unity-spy\UnitySpy.HearthstoneLib\Detail\Deck\ActiveDeckReader.cs;..\..\..\HDT_Reverse\unity-spy\UnitySpy.HearthstoneLib\MemoryUpdate\**"
             LinkBase="HearthstoneLib" />
  </ItemGroup>

  <!-- NuGet packages needed by UnitySpy -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.ValueTuple" Version="4.5.0" />
    <PackageReference Include="JetBrains.Annotations" Version="2024.2.0" />
  </ItemGroup>

  <!-- net472 needs explicit Microsoft.CSharp reference for dynamic -->
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

</Project>
