<UserControl x:Class="HBT.Windows.GameToolsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#CC1e293b" BorderBrush="#334155" BorderThickness="1"
            CornerRadius="6" Padding="11,8">
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="TurnNumberText" Text="" FontSize="14" FontWeight="Bold" Foreground="#e2e8f0"
                       VerticalAlignment="Center" Margin="0,0,11,0"/>
            <StackPanel x:Name="RacePanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,11,0"/>
            <Button x:Name="CardBrowserToggleBtn" Content="查询"
                    Click="CardBrowserToggleBtn_Click"
                    Background="#555555" Foreground="White" FontWeight="Bold" FontSize="13"
                    Padding="10,6" BorderThickness="0" Cursor="Hand" Margin="0,0,11,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="DisconnectBtn" Content="一键拔线"
                    Click="DisconnectBtn_Click"
                    Background="#555555" Foreground="White" FontWeight="Bold" FontSize="14"
                    Padding="13,6" BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
