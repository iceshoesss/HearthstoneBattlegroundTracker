<Window x:Class="HBT.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HBT" Height="560" Width="460"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimary}"
        Foreground="{StaticResource TextPrimary}"
        ResizeMode="CanMinimize"
        FontFamily="Microsoft YaHei UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="90"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PlayerName" Text="等待游戏启动..." FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <Border x:Name="RegionBadge" Background="#8B7355" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="RegionText" Text="" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="PlayerMmr" Text="" FontSize="11" Foreground="#22c55e" Margin="0,2,0,0"/>
                </StackPanel>
                <TextBlock x:Name="StatusLabel" Text="○ 检测中..." HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
            </Grid>
        </Border>

        <!-- Game Status -->
        <Border Grid.Row="1" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="GameIcon" Text="⏳" FontSize="28" HorizontalAlignment="Center"/>
                <TextBlock x:Name="GameText" Text="等待对局中..." HorizontalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                <TextBlock x:Name="GameSub" Text="联赛模式已启用" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Recent Games + Stats -->
        <Border Grid.Row="2" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>

                <!-- Recent Games -->
                <StackPanel Grid.Column="0" Margin="16,10,10,10">
                    <TextBlock Text="最近战绩" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="RecentGamesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border Background="{Binding PlacementColor}" Width="26" Height="26" CornerRadius="4" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding PlacementText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                    <TextBlock Text="{Binding HeroName}" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextPrimary}" Width="170"/>
                                    <TextBlock Text="{Binding PointsText}" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{Binding PointsColor}" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Divider -->
                <Border Grid.Column="1" Background="{StaticResource BorderColor}"/>

                <!-- Stats -->
                <StackPanel Grid.Column="2" Margin="10,10,16,10">
                    <TextBlock Text="今日统计" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>

                    <!-- MMR 变动 -->
                    <TextBlock x:Name="StatMmrChange" Text="MMR: -" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,2"/>
                    <TextBlock x:Name="StatMmrStart" Text="起始: -" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>

                    <!-- 分隔线 -->
                    <Border Background="{StaticResource BorderColor}" Height="1" Margin="0,0,0,8"/>

                    <!-- 基础数据 -->
                    <TextBlock x:Name="StatGames" Text="总局数 0" FontSize="11" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="StatWinRate" Text="胜率 0%" FontSize="11" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="StatAvgPlace" Text="场均排名 -" FontSize="11" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>

                    <!-- 吃鸡 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Background="#f59e0b" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                            <TextBlock Text="吃鸡" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <TextBlock x:Name="StatFirst" Text="0" FontSize="11" FontWeight="Bold" Foreground="#f59e0b" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatFirstRate" Text=" 0%" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 速八 -->
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#ef4444" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                            <TextBlock Text="速八" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <TextBlock x:Name="StatEighth" Text="0" FontSize="11" FontWeight="Bold" Foreground="#ef4444" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatEighthRate" Text=" 0%" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Verification Code -->
        <Border Grid.Row="3" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="验证码" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock x:Name="VerifyCode" Text="待接入" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" FontFamily="Consolas" Margin="0,2,0,0"/>
                </StackPanel>
                <Button x:Name="BtnCopyCode" Content="📋 复制" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="{StaticResource BgTertiary}" Foreground="{StaticResource TextSecondary}"
                        BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="14,6" Cursor="Hand"
                        FontSize="11"
                        Click="BtnCopyCode_Click"/>
            </Grid>
        </Border>

        <!-- Log -->
        <Border Grid.Row="4" Background="{StaticResource BgPrimary}">
            <Grid>
                <TextBlock Text="日志" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="16,6,0,0"/>
                <TextBox x:Name="LogBox" VerticalScrollBarVisibility="Auto" IsReadOnly="True"
                         Background="#0a0f19" Foreground="#94a3b8" FontFamily="Consolas" FontSize="11"
                         BorderThickness="0" Margin="0,24,0,0" TextWrapping="Wrap"/>
            </Grid>
        </Border>
    </Grid>
</Window>
