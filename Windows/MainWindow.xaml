<Window x:Class="HBT.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HBT - 联赛工具" Height="400" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#0a0f19"
        Foreground="White"
        ResizeMode="CanMinimize"
        FontFamily="Microsoft YaHei UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="90"/>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1a1f2e" BorderBrush="#2a3040" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PlayerName" Text="等待游戏启动..." FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <Border x:Name="RegionBadge" Background="#8B7355" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="RegionText" Text="" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="PlayerMmr" Text="" FontSize="11" Foreground="#22c55e" Margin="0,2,0,0"/>
                </StackPanel>
                <TextBlock x:Name="StatusLabel" Text="○ 检测中..." HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#64748b"/>
            </Grid>
        </Border>

        <!-- Game Status -->
        <Border Grid.Row="1" Background="#1a1f2e" BorderBrush="#2a3040" BorderThickness="0,0,0,1">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="GameIcon" Text="⏳" FontSize="28" HorizontalAlignment="Center"/>
                <TextBlock x:Name="GameText" Text="等待对局中..." HorizontalAlignment="Center" FontSize="13" Foreground="#94a3b8" Margin="0,4,0,0"/>
                <TextBlock x:Name="GameSub" Text="联赛模式已启用" HorizontalAlignment="Center" FontSize="11" Foreground="#64748b" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Verification Code -->
        <Border Grid.Row="2" Background="#1a1f2e" BorderBrush="#2a3040" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="验证码" FontSize="10" Foreground="#64748b"/>
                    <TextBlock x:Name="VerifyCode" Text="待接入" FontSize="14" FontWeight="Bold" Foreground="#3b82f6" FontFamily="Consolas" Margin="0,2,0,0"/>
                </StackPanel>
                <Button x:Name="BtnCopyCode" Content="📋 复制" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#2a3040" Foreground="#94a3b8"
                        BorderBrush="#2a3040" BorderThickness="1" Padding="14,6" Cursor="Hand"
                        FontSize="11"
                        Click="BtnCopyCode_Click"/>
            </Grid>
        </Border>

        <!-- Log -->
        <Border Grid.Row="3" Background="#0a0f19">
            <Grid>
                <TextBlock Text="日志" FontSize="10" FontWeight="Bold" Foreground="#64748b" Margin="16,6,0,0"/>
                <TextBox x:Name="LogBox" VerticalScrollBarVisibility="Auto" IsReadOnly="True"
                         Background="#0a0f19" Foreground="#94a3b8" FontFamily="Consolas" FontSize="11"
                         BorderThickness="0" Margin="0,24,0,0" TextWrapping="Wrap"/>
            </Grid>
        </Border>
    </Grid>
</Window>
