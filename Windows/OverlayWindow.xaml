<Window x:Class="HBT.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HBT.Windows"
        Title="HBT Overlay" Height="100" Width="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Left="0" Top="0">
    <Window.Resources>
        <Style x:Key="FilterBtn" TargetType="Button">
            <Setter Property="Background" Value="#1e293b"/>
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FilterBtnActive" TargetType="Button" BasedOn="{StaticResource FilterBtn}">
            <Setter Property="Background" Value="#1e3a5f"/>
            <Setter Property="Foreground" Value="#60a5fa"/>
            <Setter Property="BorderBrush" Value="#3b82f6"/>
        </Style>
    </Window.Resources>
    <Grid x:Name="OverlayGrid" Background="Transparent">
        <!-- BobsBuddy Panel (top center, read-only) -->
        <Border x:Name="BobsBuddyPanel"
                Background="#CC1e293b" BorderBrush="#334155" BorderThickness="1"
                CornerRadius="6" Padding="12,8" MinWidth="280"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
                Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="胜率" FontSize="8" Foreground="#94a3b8" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="WinRateText" Text="-" FontSize="18" FontWeight="Bold" Foreground="#22c55e" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="平局" FontSize="8" Foreground="#94a3b8" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TieRateText" Text="-" FontSize="18" FontWeight="Bold" Foreground="#f59e0b" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="败率" FontSize="8" Foreground="#94a3b8" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="LossRateText" Text="-" FontSize="18" FontWeight="Bold" Foreground="#ef4444" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="我方伤害" FontSize="8" Foreground="#94a3b8" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="PlayerDamageText" Text="-" FontSize="12" FontWeight="Bold" Foreground="#22c55e" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="对方伤害" FontSize="8" Foreground="#94a3b8" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="OpponentDamageText" Text="-" FontSize="12" FontWeight="Bold" Foreground="#ef4444" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Card Browser Panel (top right, interactive, draggable) -->
        <Border x:Name="CardBrowserPanel"
                Background="#CC1e293b" BorderBrush="#334155" BorderThickness="1"
                CornerRadius="6" Padding="10,8" Width="260"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                Visibility="Collapsed">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <Button Content="✕" HorizontalAlignment="Right" Background="Transparent"
                            Foreground="#94a3b8" BorderThickness="0" Cursor="Hand" Padding="4,0"
                            Click="CloseCardBrowser_Click"/>
                </Grid>
                <!-- Filters: 无标签，用分隔线划分 -->
                <StackPanel Margin="0,0,0,4">
                    <!-- 等级 -->
                    <WrapPanel Margin="0,0,0,3">
                        <Button Content="1" Tag="1" Click="TierFilter_Click" Style="{StaticResource FilterBtn}"/>
                        <Button Content="2" Tag="2" Click="TierFilter_Click" Style="{StaticResource FilterBtn}"/>
                        <Button Content="3" Tag="3" Click="TierFilter_Click" Style="{StaticResource FilterBtn}"/>
                        <Button Content="4" Tag="4" Click="TierFilter_Click" Style="{StaticResource FilterBtn}"/>
                        <Button Content="5" Tag="5" Click="TierFilter_Click" Style="{StaticResource FilterBtn}"/>
                        <Button Content="6" Tag="6" Click="TierFilter_Click" Style="{StaticResource FilterBtn}"/>
                        <Button Content="7" Tag="7" Click="TierFilter_Click" Style="{StaticResource FilterBtn}"/>
                    </WrapPanel>
                    <Border Height="1" Background="#334155" Margin="0,0,0,3"/>
                    <!-- 种族: 1行 (5种族+无种族) -->
                    <WrapPanel x:Name="RaceRow1" Margin="0,0,0,3"/>
                    <Border Height="1" Background="#334155" Margin="0,0,0,3"/>
                    <!-- 标签: 2行 -->
                    <WrapPanel x:Name="KeywordRow1" Margin="0,0,0,1">
                        <Button Content="战吼" Tag="战吼" Click="KeywordFilter_Click" Style="{StaticResource FilterBtn}"/>
                        <Button Content="亡语" Tag="亡语" Click="KeywordFilter_Click" Style="{StaticResource FilterBtn}"/>
                        <Button Content="复生" Tag="复生" Click="KeywordFilter_Click" Style="{StaticResource FilterBtn}"/>
                        <Button Content="圣盾" Tag="圣盾" Click="KeywordFilter_Click" Style="{StaticResource FilterBtn}"/>
                        <Button Content="回合开始" Tag="回合开始" Click="KeywordFilter_Click" Style="{StaticResource FilterBtn}"/>
                    </WrapPanel>
                    <WrapPanel x:Name="KeywordRow2" Margin="0,0,0,3">
                        <Button Content="烈毒" Tag="烈毒" Click="KeywordFilter_Click" Style="{StaticResource FilterBtn}"/>
                        <Button Content="风怒" Tag="风怒" Click="KeywordFilter_Click" Style="{StaticResource FilterBtn}"/>
                        <Button Content="嘲讽" Tag="嘲讽" Click="KeywordFilter_Click" Style="{StaticResource FilterBtn}"/>
                        <Button Content="光环" Tag="光环" Click="KeywordFilter_Click" Style="{StaticResource FilterBtn}"/>
                        <Button Content="回合结束" Tag="回合结束" Click="KeywordFilter_Click" Style="{StaticResource FilterBtn}"/>
                    </WrapPanel>
                    <Border Height="1" Background="#334155" Margin="0,0,0,3"/>
                </StackPanel>
                <!-- Card list: 瓦片图 + 名字叠层 -->
                <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CardList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="250" CornerRadius="4" Margin="0,0,2,2" ClipToBounds="True"
                                        BorderBrush="#334155" BorderThickness="1">
                                    <Grid>
                                        <!-- BG 瓦片图: 1.25x 放大 + 右对齐裁剪（HDT 方案） -->
                                        <Image Source="{Binding Image, NotifyOnTargetUpdated=True}"
                                               Stretch="UniformToFill" HorizontalAlignment="Right"
                                               RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.RenderTransform>
                                                <ScaleTransform ScaleX="1.25" ScaleY="1.25" CenterX="125"/>
                                            </Image.RenderTransform>
                                        </Image>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                                   Foreground="White" VerticalAlignment="Bottom"
                                                   HorizontalAlignment="Left" Margin="6,0,0,4">
                                            <TextBlock.Effect>
                                                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.8"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Scoreboard Panel (left side) -->
        <Border x:Name="ScoreboardPanel"
                Background="#CC1e293b" BorderBrush="#334155" BorderThickness="1"
                CornerRadius="6" Padding="10,6" MinWidth="200"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="80,60,0,0"
                Visibility="Collapsed" MouseLeftButtonDown="ScoreboardPanel_MouseLeftButtonDown"
                MouseLeftButtonUp="ScoreboardPanel_MouseLeftButtonUp" MouseMove="ScoreboardPanel_MouseMove">
            <StackPanel>
                <!-- Header: race icons + gear/confirm -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="ScoreRacePanel" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <Button x:Name="ScoreSettingsBtn" Grid.Column="1" Cursor="Hand" Padding="0"
                            Click="ScoreSettingsBtn_Click"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="0">
                        <Border x:Name="ScoreSettingsBorder" Background="Transparent" CornerRadius="3" Padding="2,0">
                            <Grid>
                                <Viewbox x:Name="ScoreGearIcon" Width="14" Height="14">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="#64748b" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M10.343 3.94c.09-.542.56-.94 1.11-.94h1.093c.55 0 1.02.398 1.11.94l.149.894c.07.424.384.764.78.93.398.164.855.142 1.205-.108l.737-.527a1.125 1.125 0 0 1 1.45.12l.773.774c.39.389.44 1.002.12 1.45l-.527.737c-.25.35-.272.806-.107 1.204.165.397.505.71.93.78l.893.15c.543.09.94.559.94 1.109v1.094c0 .55-.397 1.02-.94 1.11l-.894.149c-.424.07-.764.383-.929.78-.165.398-.143.854.107 1.204l.527.738c.32.447.269 1.06-.12 1.45l-.774.773a1.125 1.125 0 0 1-1.449.12l-.738-.527c-.35-.25-.806-.272-1.203-.107-.398.165-.71.505-.781.929l-.149.894c-.09.542-.56.94-1.11.94h-1.094c-.55 0-1.019-.398-1.11-.94l-.148-.894c-.071-.424-.384-.764-.781-.93-.398-.164-.854-.142-1.204.108l-.738.527c-.447.32-1.06.269-1.45-.12l-.773-.774a1.125 1.125 0 0 1-.12-1.45l.527-.737c.25-.35.272-.806.108-1.204-.165-.397-.506-.71-.93-.78l-.894-.15c-.542-.09-.94-.56-.94-1.109v-1.094c0-.55.398-1.02.94-1.11l.894-.149c.424-.07.765-.383.93-.78.165-.398.143-.854-.108-1.204l-.526-.738a1.125 1.125 0 0 1 .12-1.45l.773-.773a1.125 1.125 0 0 1 1.45-.12l.737.527c.35.25.807.272 1.204.107.397-.165.71-.505.78-.929l.15-.894Z"/>
                                        <Path Stroke="#64748b" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
                                    </Canvas>
                                </Viewbox>
                                <Border x:Name="ScoreConfirmBtn" Background="#4ade80" CornerRadius="4" Padding="6,2"
                                         Visibility="Collapsed">
                                    <TextBlock Text="确认" Foreground="#1a1a2e" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Button>
                </Grid>
                <!-- Settings panel (collapsed by default) -->
                <StackPanel x:Name="ScoreSettingsPanel" Visibility="Collapsed" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="缩放" FontSize="9" Foreground="#64748b" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Slider Grid.Column="1" x:Name="ScoreScaleSlider" Minimum="1" Maximum="3" Value="1.2" 
                                TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="ScoreScaleSlider_ValueChanged"/>
                    </Grid>
                    <TextBlock x:Name="ScoreScaleText" Text="1.2x" FontSize="8" Foreground="#64748b" HorizontalAlignment="Right"/>
                </StackPanel>
                <!-- MMR -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="开始" FontSize="8" Foreground="#64748b" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ScoreStartMmr" Text="-" FontSize="14" FontWeight="Bold" Foreground="#e2e8f0" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="当前" FontSize="8" Foreground="#64748b" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ScoreCurrentMmr" Text="-" FontSize="14" FontWeight="Bold" Foreground="#e2e8f0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <Border Height="1" Background="#334155" Margin="0,0,0,4"/>
                <!-- Games List -->
                <ItemsControl x:Name="ScoreGamesList" MaxHeight="300"
                              MouseMove="ScoreGamesList_MouseMove" MouseLeave="ScoreGamesList_MouseLeave">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,2" Height="26">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="22" Height="22" CornerRadius="4" ClipToBounds="True"
                                        BorderBrush="#334155" BorderThickness="1" VerticalAlignment="Center">
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <ImageBrush ImageSource="{Binding HeroImage}" Stretch="UniformToFill">
                                                <ImageBrush.Transform>
                                                    <ScaleTransform ScaleX="1.2" ScaleY="1.2" CenterX="0.4" CenterY="0.5"/>
                                                </ImageBrush.Transform>
                                            </ImageBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding HeroName}" FontSize="10" Foreground="#e2e8f0"
                                           VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis"/>
                                <Border Grid.Column="2" Background="{Binding PlacementBrush}" Width="22" Height="14" CornerRadius="3"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PlacementText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="9" FontWeight="Bold" Foreground="#1a1a2e"/>
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding MMRDeltaText}" FontSize="9" FontWeight="Bold"
                                           Foreground="{Binding MMRDeltaBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- 最终阵容悬停提示 -->
                <Popup x:Name="BoardStatePopup" IsOpen="False" Placement="Right" AllowsTransparency="True"
                       PlacementTarget="{Binding ElementName=ScoreGamesList}" HorizontalOffset="8">
                    <Border Background="#1e293b" BorderBrush="#475569" BorderThickness="1" CornerRadius="6" Padding="6,10"
                            MaxWidth="480">
                        <StackPanel x:Name="BoardStatePanel" Orientation="Horizontal"/>
                    </Border>
                </Popup>
            </StackPanel>
        </Border>

        <!-- Opponent Board Panel (center top, HDT style) -->
        <Border x:Name="OpponentPanel"
                Background="#CC1e293b" BorderBrush="#334155" BorderThickness="1"
                CornerRadius="6" Padding="12,8" MinWidth="250" MinHeight="80"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- 阵容显示区域 -->
                <WrapPanel x:Name="OpponentBoardPanel" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <!-- 底部信息：左=回合信息，右=对战胜率 -->
                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="OpponentInfo" Text="" FontSize="14" Foreground="#94a3b8"
                               HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                    <TextBlock x:Name="OpponentHeadToHead" Text="" FontSize="14"
                               Foreground="#94a3b8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Grid.Column="1"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Game Tools Panel (turn number + disconnect button, left side) -->
        <Border x:Name="GameToolsPanel"
                Background="#CC1e293b" BorderBrush="#334155" BorderThickness="1"
                CornerRadius="8" Padding="14,10"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="80,250,0,0"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TurnNumberText" Text="" FontSize="18" FontWeight="Bold" Foreground="#e2e8f0"
                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                <StackPanel x:Name="GameToolsRacePanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Button x:Name="DisconnectBtn" Content="一键拔线"
                        Click="DisconnectBtn_Click"
                        Background="#555555" Foreground="White" FontWeight="Bold" FontSize="18"
                        Padding="16,8" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
