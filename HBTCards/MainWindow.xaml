<Window x:Class="HBTCards.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HBT 卡牌图鉴" Width="1560" Height="1000"
        MinWidth="1200" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="#0d0a06">

    <Window.Resources>

        <!-- ═══════════ 阴影 ═══════════ -->
        <DropShadowEffect x:Key="CardShadow" Color="#000" BlurRadius="6" ShadowDepth="2" Opacity="0.55"/>
        <DropShadowEffect x:Key="StatOutline" Color="#000" BlurRadius="2" ShadowDepth="1.5" Opacity="1"/>

        <!-- ═══════════ 颜色 ═══════════ -->
        <LinearGradientBrush x:Key="WoodFrame" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#6b4a26" Offset="0"/>
            <GradientStop Color="#4a3319" Offset="0.5"/>
            <GradientStop Color="#3a2712" Offset="1"/>
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="FeltBg" Center="0.5,0.35" RadiusX="0.9" RadiusY="0.9">
            <GradientStop Color="#5a4174" Offset="0"/>
            <GradientStop Color="#45305c" Offset="0.6"/>
            <GradientStop Color="#342347" Offset="1"/>
        </RadialGradientBrush>
        <LinearGradientBrush x:Key="PanelBg" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2a1c0d" Offset="0"/>
            <GradientStop Color="#1d1308" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BannerBg" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#39456f" Offset="0"/>
            <GradientStop Color="#232c4d" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Parchment" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#efe5c4" Offset="0"/>
            <GradientStop Color="#d6c69a" Offset="1"/>
        </LinearGradientBrush>

        <!-- ═══════════ 等级按钮（HDT tier 图标 + 选中光晕） ═══════════ -->
        <Style x:Key="TierBtn" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="84" Height="98" Background="Transparent">
                            <Image x:Name="glow" Source="pack://application:,,,/Resources/Tiers/tier-glow.png"
                                   Visibility="Collapsed"/>
                            <ContentPresenter/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="glow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════ 圆形种族按钮 ═══════════ -->
        <Style x:Key="CircleBtn" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="76" Height="86" Background="Transparent">
                            <Ellipse x:Name="halo" Fill="#22ffce54" Visibility="Collapsed"/>
                            <Ellipse x:Name="ring" Stroke="#6b5433" StrokeThickness="3" Margin="6,6,6,16"/>
                            <ContentPresenter Margin="9,9,9,19"/>
                            <Border VerticalAlignment="Bottom" Background="#aa141008"
                                    CornerRadius="4" Padding="4,1" HorizontalAlignment="Center" Margin="4">
                                <TextBlock Text="{TemplateBinding Tag}" FontSize="10" Foreground="#d9c184"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ring" Property="Stroke" Value="#ffe9a8"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="halo" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ring" Property="Stroke" Value="#ffd75e"/>
                                <Setter TargetName="ring" Property="StrokeThickness" Value="4"/>
                                <Setter TargetName="ring" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#ffce54" BlurRadius="16" ShadowDepth="0" Opacity="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════ 随从卡（BoardRenderer 同款 256 画布，Viewbox 缩放） ═══════════ -->
        <DataTemplate x:Key="MinionTpl">
            <Grid Width="168" Height="200" Margin="5,7" Background="Transparent" ToolTip="{Binding Name}">
                <!-- 星级盾徽（游戏内样式，约 1/3 压在头像上） -->
                <Image Source="{Binding TierIcon}" Width="52" VerticalAlignment="Top"
                       HorizontalAlignment="Center" Panel.ZIndex="3" Margin="0,4,0,0"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Effect="{StaticResource CardShadow}"/>
                <!-- 256 画布等比缩放 -->
                <Viewbox Width="164" Height="164" VerticalAlignment="Bottom">
                    <Canvas Width="256" Height="256">
                        <!-- 嘲讽 -->
                        <Image Source="pack://application:,,,/Resources/Minion/taunt.png"
                               Width="300" Height="350" Canvas.Left="-24" Canvas.Top="-36"
                               Visibility="{Binding TauntVis}"/>
                        <!-- 肖像（椭圆裁剪） -->
                        <Rectangle Width="256" Height="256" RenderOptions.BitmapScalingMode="HighQuality">
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill"/>
                            </Rectangle.Fill>
                            <Rectangle.Clip>
                                <EllipseGeometry Center="128,128" RadiusX="87" RadiusY="120"/>
                            </Rectangle.Clip>
                        </Rectangle>
                        <!-- 边框 -->
                        <Image Source="pack://application:,,,/Resources/Minion/border.png"
                               Width="300" Height="350" Canvas.Left="-24" Canvas.Top="-36"/>
                        <!-- 复生 / 亡语 / 剧�?/ 烈毒 -->
                        <Image Source="pack://application:,,,/Resources/Minion/reborn.png"
                               Width="300" Height="350" Canvas.Left="-24" Canvas.Top="-36"
                               Visibility="{Binding RebornVis}"/>
                        <Image Source="pack://application:,,,/Resources/Minion/deathrattle.png"
                               Width="300" Height="350" Canvas.Left="-24" Canvas.Top="-36"
                               Visibility="{Binding DeathrattleVis}"/>
                        <Image Source="pack://application:,,,/Resources/Minion/poisonous.png"
                               Width="300" Height="350" Canvas.Left="-24" Canvas.Top="-36"
                               Visibility="{Binding PoisonousVis}"/>
                        <Image Source="pack://application:,,,/Resources/Minion/venomous.png"
                               Width="300" Height="350" Canvas.Left="-24" Canvas.Top="-36"
                               Visibility="{Binding VenomousVis}"/>
                        <!-- 属性面板 -->
                        <Image Source="pack://application:,,,/Resources/Minion/stats.png"
                               Width="300" Height="350" Canvas.Left="-24" Canvas.Top="-36"/>
                        <!-- 圣盾 -->
                        <Image Source="pack://application:,,,/Resources/Minion/divine-shield.png"
                               Width="325" Height="311" Canvas.Left="-36" Canvas.Top="-24"
                               Visibility="{Binding DivineShieldVis}"/>
                        <!-- 攻击力 -->
                        <TextBlock Text="{Binding AtkText}" FontSize="45" FontWeight="Bold"
                                   FontFamily="pack://application:,,,/Resources/#Chunkfive"
                                   Foreground="{Binding AtkBrush}"
                                   Width="75" Height="75" TextAlignment="Center"
                                   Canvas.Left="29" Canvas.Top="185"
                                   Effect="{StaticResource StatOutline}"/>
                        <!-- 生命值 -->
                        <TextBlock Text="{Binding HpText}" FontSize="45" FontWeight="Bold"
                                   FontFamily="pack://application:,,,/Resources/#Chunkfive"
                                   Foreground="{Binding HpBrush}"
                                   Width="75" Height="75" TextAlignment="Center"
                                   Canvas.Left="151" Canvas.Top="185"
                                   Effect="{StaticResource StatOutline}"/>
                    </Canvas>
                </Viewbox>
            </Grid>
        </DataTemplate>

        <!-- ═══════════ 分组区头 ═══════════ -->
        <DataTemplate x:Key="SectionHdrTpl">
            <Grid Margin="30,14,30,4" Height="34">
                <Rectangle Height="2" VerticalAlignment="Center" Margin="0,0,0,4">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00b99a5e" Offset="0"/>
                            <GradientStop Color="#b99a5e" Offset="0.5"/>
                            <GradientStop Color="#00b99a5e" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <TextBlock Text="❖" Foreground="#b99a5e" FontSize="11" VerticalAlignment="Center"
                           HorizontalAlignment="Left" Margin="60,0,0,4"/>
                <TextBlock Text="❖" Foreground="#b99a5e" FontSize="11" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Margin="0,0,60,4"/>
                <Border Background="#45305c" Padding="26,4" VerticalAlignment="Center"
                        HorizontalAlignment="Center" CornerRadius="3" Margin="0,0,0,4"
                        BorderBrush="#b99a5e" BorderThickness="0,0,0,1">
                    <TextBlock Text="{Binding}" FontSize="16" FontWeight="Bold" Foreground="#e3cf9b"/>
                </Border>
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <!-- ═══════════════ 木纹外框 ═══════════════ -->
    <Border Margin="14" CornerRadius="22" Background="{StaticResource WoodFrame}"
            BorderBrush="#241708" BorderThickness="2">
        <Border CornerRadius="20" BorderBrush="#668a6a3f" BorderThickness="1" Margin="4" Padding="12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="216"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="216"/>
                </Grid.ColumnDefinitions>

                <!-- ───── 左：等级 ───── -->
                <Border Grid.Column="0" CornerRadius="12" Background="{StaticResource PanelBg}"
                        BorderBrush="#77572e" BorderThickness="1" Margin="0,0,10,0">
                    <StackPanel>
                        <Grid Height="36" Margin="14,12,14,4">
                            <Path Data="M0,6 L10,0 H110 L120,6 L110,12 H10 Z" Fill="{StaticResource BannerBg}"
                                  Stroke="#b08d4f" StrokeThickness="1" Stretch="Uniform"/>
                            <TextBlock Text="等  级" FontSize="15" FontWeight="Bold" Foreground="#e8d5a2"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <UniformGrid x:Name="TierRow" Columns="2" Margin="14,8,14,0"/>
                    </StackPanel>
                </Border>

                <!-- ───── 中：随从列表 ───── -->
                <Border Grid.Column="1" CornerRadius="14" Background="{StaticResource FeltBg}"
                        BorderBrush="#20142e" BorderThickness="2">
                    <Grid Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="52"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 标题牌匾 -->
                        <Border Grid.Row="0" Width="430" Height="34" VerticalAlignment="Top"
                                Background="{StaticResource Parchment}" CornerRadius="5"
                                BorderBrush="#8a7345" BorderThickness="1" Margin="0,14,0,0"
                                Effect="{StaticResource CardShadow}">
                            <TextBlock Text="随 从" FontSize="16" FontWeight="Bold" Foreground="#3a2c18"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="6,4,14,4">
                            <ItemsControl x:Name="SectionsView">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <ContentPresenter Content="{Binding Title}"
                                                              ContentTemplate="{StaticResource SectionHdrTpl}"/>
                                            <ItemsControl ItemsSource="{Binding Cards}"
                                                          ItemTemplate="{StaticResource MinionTpl}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel HorizontalAlignment="Center"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- ───── 右：类型 ───── -->
                <Border Grid.Column="2" CornerRadius="12" Background="{StaticResource PanelBg}"
                        BorderBrush="#77572e" BorderThickness="1" Margin="10,0,0,0">
                    <StackPanel>
                        <Grid Height="36" Margin="14,12,14,4">
                            <Path Data="M0,6 L10,0 H110 L120,6 L110,12 H10 Z" Fill="{StaticResource BannerBg}"
                                  Stroke="#b08d4f" StrokeThickness="1" Stretch="Uniform"/>
                            <TextBlock Text="类  型" FontSize="15" FontWeight="Bold" Foreground="#e8d5a2"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <UniformGrid x:Name="RaceRow" Columns="2" Margin="14,8,14,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
